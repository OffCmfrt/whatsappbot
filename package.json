{
  "name": "whatsapp-order-bot",
  "version": "1.0.0",
  "description": "WhatsApp bot for order tracking with Shiprocket API and admin dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrateExcel.js",
    "test:redact": "node test/testRedact.js",
    "test:logger": "node test/testLogger.js",
    "test:health": "node test/testHealth.js",
    "test:zohocancel": "node test/testZohoCancelInvoiceVoid.js",
    "test:support-privacy": "node --test test/testSupportThreadPrivacy.js",
    "test:portal-thread": "node --test test/testPortalTicketThread.js",
    "test:suggest-desk": "node --test test/testSuggestReplyDesk.js",
    "test:zohoitems": "node test/testZohoItemResolver.js",
    "test:zohoreturns": "node test/testZohoReturnShipping.js",
    "test:phase1": "node test/testRedact.js && node test/testLogger.js && node test/testHealth.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "shiprocket",
    "order-tracking"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^8.0.0",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "bwip-js": "^4.11.4",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "opossum": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.3",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.5",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
