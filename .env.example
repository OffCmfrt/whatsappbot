# Server Configuration
PORT=3000
NODE_ENV=production

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here

# Shiprocket API (Choose ONE method)
# Method 1: Email + Password (Auto-refreshing, recommended)
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# Method 2: Direct Token (Expires in 10 days, manual refresh needed)
# SHIPROCKET_TOKEN=your_shiprocket_token_here

# Shipping Module (Shopper Hub) — carriers activate automatically when their env vars are set
# Shiprocket shipping (in addition to SHIPROCKET_EMAIL/PASSWORD above)
SHIPROCKET_PICKUP_LOCATION=your_registered_pickup_location_nickname
# Optional: pickup pincode is auto-resolved from the pickup location; set only to override
# SHIPROCKET_PICKUP_PINCODE=110001
# Optional: channel to file orders under (auto-resolved to your Shopify channel); set only to override
# SHIPROCKET_CHANNEL_ID=123456

# Delhivery direct API
# Either DELHIVERY_API_TOKEN or DELHIVERY_API_KEY works (they are aliases)
DELHIVERY_API_TOKEN=your_delhivery_api_token_here
DELHIVERY_PICKUP_LOCATION=your_registered_warehouse_name
# 'staging' uses staging-express.delhivery.com; anything else uses production
DELHIVERY_ENV=production
# OPTIONAL seller details printed on the Delhivery label/panel. When omitted
# they fall back to the EKART_SELLER_* values below (seller_gst_tin is the
# field Delhivery stores — legacy seller_tin_gst variants are ignored).
# DELHIVERY_SELLER_GSTIN=your_gst_tin
# DELHIVERY_SELLER_NAME=your_registered_business_name
# DELHIVERY_SELLER_ADDRESS=your_billing_address

# Ekart Elite API (app.elite.ekartlogistics.in)
EKART_CLIENT_ID=your_ekart_client_id
EKART_USERNAME=your_ekart_api_username
EKART_PASSWORD=your_ekart_api_password
# Seller details printed on the label/invoice (required by Ekart's create API)
EKART_SELLER_NAME=your_registered_business_name
EKART_SELLER_ADDRESS=your_billing_address
EKART_SELLER_GST_TIN=your_gst_tin
# Optional: pickup/RTO address alias — only needed when MULTIPLE pickup addresses
# are registered with Ekart (single address is autofilled automatically)
# EKART_PICKUP_ALIAS=your_pickup_address_alias
# EKART_RETURN_ALIAS=your_rto_address_alias
# Optional: pickup pincode — enables shipping rate estimates in the ship modal
# EKART_PICKUP_PINCODE=110001
# Optional: category of goods on the shipment (default: Apparel)
# EKART_CATEGORY_OF_GOODS=Apparel
# Optional: API base URL override (default https://app.elite.ekartlogistics.in)
# EKART_BASE_URL=https://app.elite.ekartlogistics.in

# Database (Choose ONE)
# Option 1: Supabase PostgreSQL (Recommended - No read limits on free tier)
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Option 2: Turso (Legacy - 9GB storage but read limits)
# TURSO_DATABASE_URL=libsql://whatsapp-bot-yourname.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
JWT_SECRET=your_random_jwt_secret_key_here

# Shoppers Hub master access code (password-only admin login on the Shoppers Hub page).
# NOTE: this is separate from ADMIN_PASSWORD — change this one to rotate the
# Shoppers Hub master password. Changing it instantly invalidates old sessions.
SHOPPERS_HUB_PASSWORD=change_this_hub_access_code

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Application URL (for payment callbacks)
APP_URL=https://your-app.onrender.com

# Optional: For development
WEBHOOK_URL=https://your-app.onrender.com/webhook

# Shopify Admin API (used by the AI copilot's order lookup tool)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here

# GoKwik Checkout (order/cart/status sync — keeps existing orders in sync, never changes order source)
# Register these webhook URLs in the GoKwik Dashboard (any/all of them work):
#   POST {APP_URL}/webhooks/gokwik/events          ← generic dispatcher (recommended)
#   POST {APP_URL}/webhooks/gokwik/order-created
#   POST {APP_URL}/webhooks/gokwik/abandoned-cart
#   POST {APP_URL}/webhooks/gokwik/order-status
GOKWIK_APP_ID=your_gokwik_app_id_here
GOKWIK_APP_SECRET=your_gokwik_app_secret_here
# Optional: dedicated webhook signing secret (defaults to GOKWIK_APP_SECRET)
# GOKWIK_WEBHOOK_SECRET=your_gokwik_webhook_secret_here
# Optional: API base URL override (default https://api.gokwik.co)
# GOKWIK_BASE_URL=https://api.gokwik.co
# Optional: account-specific order-update endpoint path (ask GoKwik support).
# When set, admin order edits from the Shoppers Hub are also pushed to GoKwik
# (POST {GOKWIK_BASE_URL}{GOKWIK_ORDER_UPDATE_PATH}); until then GoKwik stays
# in sync via the Shopify order, which is always updated.
# GOKWIK_ORDER_UPDATE_PATH=/v1/orders/update

# AI Admin Copilot + Reply Suggestions (Groq free tier by default — console.groq.com)
# Provider-agnostic: set AI_PROVIDER to groq/openai/deepseek/gemini or override AI_BASE_URL
AI_PROVIDER=groq
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile
# Optional override; defaults follow AI_PROVIDER
# AI_BASE_URL=https://api.groq.com/openai/v1
# Per-admin daily request cap (also editable in settings: ai_daily_admin_limit)
AI_DAILY_ADMIN_LIMIT=50
# AI learning: semantic search over learned replies (optional but recommended).
# Free Gemini key from aistudio.google.com/apikey; not needed if AI_PROVIDER=gemini.
# Without it, learning falls back to Postgres full-text search automatically.
# AI_EMBED_API_KEY=AIza_your_gemini_key_here
# AI_EMBED_MODEL=gemini-embedding-001

# Cross-system AI data (lets the copilot query the exchange-return server)
RETURNS_SERVER_URL=https://your-returns-app.onrender.com
# Shared secret — must match WHATSAPP_INTERNAL_TOKEN on the returns server
WHATSAPP_INTERNAL_TOKEN=generate_a_long_random_string_here
