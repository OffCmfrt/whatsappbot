                    <label>Custom Date Range</label>
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <input type="date" id="exportStartDate" style="flex: 1;">
                        <span style="color: #666;">to</span>
                        <input type="date" id="exportEndDate" style="flex: 1;">
                    </div>
                </div>
                
                <div class="export-option-group">
                    <label>Order ID Range (Optional)</label>
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <input type="text" id="exportOrderIdFrom" placeholder="From Order #" style="flex: 1;">
                        <span style="color: #666;">to</span>
                        <input type="text" id="exportOrderIdTo" placeholder="To Order #" style="flex: 1;">
                    </div>
                </div>
                
                <div class="export-option-group">
                    <label>Format</label>
                    <select id="exportFormat">
                        <option value="xlsx">Excel (.xlsx)</option>
                        <option value="csv">CSV (.csv)</option>
                    </select>
                </div>
                
                <div class="export-checkbox-group">
                    <input type="checkbox" id="includeCustomerMessage" checked>
                    <label for="includeCustomerMessage">Include Customer Messages</label>
                </div>
                
                <div class="export-checkbox-group">
                    <input type="checkbox" id="includeAddress" checked>
                    <label for="includeAddress">Include Address Details</label>
                </div>
            </div>
            
            <div class="export-btn-row">
                <button class="btn btn-outline" id="cancelExport">Cancel</button>
                <button class="btn btn-primary" id="confirmExport">
                    <img src="{{ 'export-icon.svg' | asset_url }}" width="16" height="16" alt="Export" style="vertical-align: middle; margin-right: 6px;" />
                    Export Now
                </button>
            </div>
        </div>
    </div>

    <!-- Shipping Modal (3-step wizard) -->
    <div id="shipModal">
        <div class="ship-modal-content">
            <div class="ship-modal-header">
                <h3>🚚 Ship Order <span class="ship-order-label" id="shipOrderIdLabel"></span></h3>
                <button class="ship-close" onclick="closeShipModal()">&times;</button>
            </div>
            <div id="shipReshipBanner"></div>
            <div class="ship-steps">
                <div class="ship-step-tab active" id="shipStepTab1">1 &middot; Review &amp; Package</div>
                <div class="ship-step-tab" id="shipStepTab2">2 &middot; Carrier &amp; Rates</div>
                <div class="ship-step-tab" id="shipStepTab3">3 &middot; Confirm &amp; Ship</div>
            </div>
            <div class="ship-body">
                <!-- Step 1: Review & Package -->
                <div class="ship-step-panel active" id="shipStep1">
                    <div class="ship-validation-errors" id="shipValidationErrors"></div>
                    <div class="ship-section-title">Consignee</div>
                    <div class="ship-grid-2">
                        <div class="form-group"><label>Name</label><input type="text" id="shipName"></div>
                        <div class="form-group"><label>Phone</label><input type="text" id="shipPhone"></div>
                    </div>
                    <div class="form-group"><label>Address</label><textarea id="shipAddress" rows="2"></textarea></div>
                    <div class="ship-grid-2">
                        <div class="form-group"><label>City</label><input type="text" id="shipCity"></div>
                        <div class="form-group"><label>State</label><input type="text" id="shipState"></div>
                    </div>
                    <div class="ship-grid-2">
                        <div class="form-group"><label>Pincode</label><input type="text" id="shipPincode" maxlength="6"></div>
                        <div class="form-group"><label>Payment</label><div id="shipPaymentBadge"></div></div>
                    </div>
                    <div class="ship-section-title">Order Items, Pricing &amp; Payment <span class="ship-edit-hint">edits are saved to the order when you continue</span></div>
                    <div id="shipOrderEditor"></div>
                    <div class="ship-section-title">Package</div>
                    <div class="ship-grid-4">
                        <div class="form-group"><label>Weight (g)</label><input type="number" id="shipWeight" min="1"></div>
                        <div class="form-group"><label>Length (cm)</label><input type="number" id="shipLength" min="1"></div>
                        <div class="form-group"><label>Breadth (cm)</label><input type="number" id="shipBreadth" min="1"></div>
                        <div class="form-group"><label>Height (cm)</label><input type="number" id="shipHeight" min="1"></div>
                    </div>
                </div>
                <!-- Step 2: Carrier & Rates -->
                <div class="ship-step-panel" id="shipStep2">
                    <div class="ship-section-title">Choose Carrier</div>
                    <div class="ship-carrier-cards" id="shipCarrierCards"></div>
                    <div id="shipServiceabilityResult"></div>
                </div>
                <!-- Step 3: Confirm & Ship -->
                <div class="ship-step-panel" id="shipStep3">
                    <div id="shipConfirmView">
                        <div class="ship-section-title">Shipment Summary</div>
                        <table class="ship-summary-table" id="shipSummaryTable"></table>
                        <div class="ship-notify-row">
                            <input type="checkbox" id="shipNotifyCustomer">
                            <label for="shipNotifyCustomer" style="cursor: pointer;">Notify customer on WhatsApp after AWB is assigned</label>
                        </div>
                        <div id="shipSubmitError"></div>
                    </div>
                    <div id="shipSuccessPanel" style="display: none;"></div>
                </div>
            </div>
            <div class="ship-footer">
                <button class="btn btn-outline" id="shipBackBtn" onclick="shipGoBack()">Back</button>
                <button class="btn btn-primary" id="shipNextBtn" onclick="shipGoNext()">Next</button>
            </div>
        </div>
    </div>

    <!-- Shipments Drawer (per-order history) -->
    <div id="shipmentsDrawer" onclick="if(event.target === this) closeShipmentsDrawer()">
        <div class="shipments-drawer-content">
            <div class="shipments-drawer-header">
                <h3>📦 Shipments <span style="color: #25d366;" id="shipmentsDrawerOrderId"></span></h3>
                <button class="ship-close" onclick="closeShipmentsDrawer()">&times;</button>
            </div>
            <div class="shipments-drawer-body" id="shipmentsDrawerBody"></div>
        </div>
    </div>

    <!-- Bulk Ship Modal -->
    <div id="bulkShipModal">
        <div class="bulk-ship-content">
            <div class="ship-modal-header">
                <h3>🚚 Bulk Ship <span class="ship-order-label" id="bulkShipCount"></span></h3>
                <button class="ship-close" onclick="closeBulkShipModal()">&times;</button>
            </div>
            <div class="ship-body">
                <div class="form-group">
                    <label>Carrier</label>
                    <select id="bulkShipCarrier" style="width: 100%; padding: 0.8rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; color: #fff;"></select>
                </div>
                <div class="ship-grid-4">
                    <div class="form-group"><label>Weight (g)</label><input type="number" id="bulkShipWeight" value="500" min="1"></div>
                    <div class="form-group"><label>Length (cm)</label><input type="number" id="bulkShipLength" value="30" min="1"></div>
                    <div class="form-group"><label>Breadth (cm)</label><input type="number" id="bulkShipBreadth" value="40" min="1"></div>
                    <div class="form-group"><label>Height (cm)</label><input type="number" id="bulkShipHeight" value="2" min="1"></div>
                </div>
                <div style="font-size: 0.75rem; color: #888;">Shiprocket auto-assigns the cheapest courier per order. Only confirmed, un-shipped orders will be processed.</div>
                <div class="bulk-ship-progress" id="bulkShipProgress"></div>
            </div>
            <div class="ship-footer">
                <button class="btn btn-outline" onclick="closeBulkShipModal()">Close</button>
                <button class="btn btn-primary" id="bulkShipStartBtn" onclick="startBulkShip()">Start Shipping</button>
            </div>
        </div>
    </div>

    <!-- Shopify Cancel & Refund Modal (premium bulk action for cancelled orders) -->
    <div id="shopifyCancelModal">
        <div class="bulk-ship-content" style="max-width: 640px;">
            <div class="ship-modal-header">
                <h3>✨ Shopify Cancel &amp; Refund <span class="ship-order-label" id="scCancelCount"></span></h3>
                <button class="ship-close" onclick="closeShopifyCancelModal()">&times;</button>
            </div>
            <div class="ship-body">
                <div class="sc-summary" id="scSummary"></div>
                <label class="sc-refund-toggle">
                    <input type="checkbox" id="scRefundToggle" checked>
                    <span>Refund prepaid orders automatically (full refund incl. shipping)</span>
                </label>
                <div style="font-size: 0.75rem; color: #888;">Prepaid orders are fully refunded in Shopify before the order is cancelled; COD orders are cancelled only. Already-cancelled orders in Shopify are skipped safely.</div>
                <div class="bulk-ship-progress" id="scProgress"></div>
            </div>
            <div class="ship-footer">
                <button class="btn btn-outline" onclick="closeShopifyCancelModal()">Close</button>
                <button class="btn btn-primary" id="scStartBtn" onclick="startShopifyCancel()" style="background: linear-gradient(135deg, #ffd166, #ffa502); color: #000; font-weight: 700;">Start Cancellation</button>
            </div>
        </div>
    </div>

    <!-- New Forward Shipment Modal (ship any order by its Order ID) -->
    <div id="soNewShipModal" onclick="if(event.target === this) closeSoNewShipModal()">
        <div class="ship-modal-content" style="max-width: 660px;">
            <div class="ship-modal-header">
                <h3>➕ New Forward Shipment</h3>
                <button class="ship-close" onclick="closeSoNewShipModal()">&times;</button>
            </div>
            <div class="ship-body">
                <div class="form-group">
                    <label>Find Order</label>
                    <input type="text" id="soLookupInput" placeholder="Type an Order ID, customer name, phone or AWB..." autocomplete="off">
                </div>
                <div style="font-size: 0.75rem; color: #888; margin-bottom: 0.85rem;">Pick an order below — consignee, items and payment details are grabbed automatically. You only choose the carrier.</div>
                <div id="soLookupResults"></div>
            </div>
        </div>
    </div>

    <!-- Premium Re-Ship Modal (reason-tracked replacement shipments) -->
    <div id="reshipModal" onclick="if(event.target === this) closeReshipModal()">
        <div class="ship-modal-content" style="max-width: 640px;">
            <div class="ship-modal-header">
                <h3>🔄 Re-Ship Order <span class="ship-order-label" id="reshipOrderIdLabel"></span></h3>
                <button class="ship-close" onclick="closeReshipModal()">&times;</button>
            </div>
            <div class="ship-body">
                <div id="reshipPrevSummary"></div>
                <div class="ship-section-title">Why are you re-shipping?</div>
                <div class="reship-reason-grid" id="reshipReasonGrid"></div>
                <div class="form-group">
                    <label>Note <span style="color:#888; font-weight:400;">(optional — saved in the shipment audit trail)</span></label>
                    <input type="text" id="reshipNote" maxlength="200" placeholder="e.g. courier confirmed package lost at hub" autocomplete="off">
                </div>
                <div id="reshipWarnBox"></div>
                <div id="reshipError"></div>
            </div>
            <div class="ship-footer">
                <button class="btn btn-outline" onclick="closeReshipModal()">Back</button>
                <button class="btn btn-primary" id="reshipContinueBtn" onclick="reshipContinue()">Continue</button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="{{ 'shoppers-app.js' | asset_url }}?v=1755100000"></script>
    <script src="{{ 'shoppers-ai-copilot-pro.js' | asset_url }}?v=1"></script>
</body>
</html>
