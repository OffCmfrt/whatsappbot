{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopper Management | OFFCOMFRT</title>
    <!-- Google Fonts: Outfit, Inter, Archivo Narrow -->
    {% # theme-check-disable RemoteAsset %}
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700&family=Inter:wght@400;500;600&family=Archivo+Narrow:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% # theme-check-enable RemoteAsset %}
    <link rel="stylesheet" href="{{ 'shoppers-hub.css' | asset_url }}?v=1755100000">
</head>
<body class="dark-theme">
    <!-- Login View -->
    <div id="loginView" style="display: none; height: 100vh; align-items: center; justify-content: center; background: #0a0a0a;">
        <div style="background: rgba(20, 20, 20, 0.8); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 48px; width: 100%; max-width: 440px; text-align: center; box-shadow: 0 24px 40px rgba(0, 0, 0, 0.5);">
            <img src="{{ 'logo.png' | asset_url }}" alt="OFFCOMFRT" style="height:48px; margin-bottom:16px;">
            <h1 style="font-family: 'Outfit', sans-serif; font-size: 28px; letter-spacing: 4px; margin: 0 0 8px 0; text-transform: uppercase;">OFFCOMFRT</h1>
            <span style="font-size: 11px; font-weight: 600; letter-spacing: 2px; padding: 4px 10px; background: #fff; color: #000; border-radius: 20px; text-transform: uppercase; display: inline-block;">SHOPPER HUB</span>
            
            <form id="shopperLoginForm" style="margin-top: 40px; text-align: left;">
                <label style="display: block; font-size: 12px; font-weight: 500; color: rgba(255, 255, 255, 0.6); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px;">Operator ID <span style="opacity:0.5; text-transform:none; letter-spacing:0;">(leave blank for admin)</span></label>
                <input type="text" id="hubUsername" placeholder="Enter Operator ID" autocomplete="username" style="width: 100%; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.12); color: #fff; padding: 16px; border-radius: 8px; outline: none; box-sizing: border-box; margin-bottom: 16px; font-family: 'Inter', sans-serif; font-size: 16px;">
                <label style="display: block; font-size: 12px; font-weight: 500; color: rgba(255, 255, 255, 0.6); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px;">Password / Access Code</label>
                <input type="password" id="hubPassword" placeholder="Enter Secure Code" required autofocus autocomplete="current-password" style="width: 100%; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.12); color: #fff; padding: 16px; border-radius: 8px; outline: none; box-sizing: border-box; margin-bottom: 16px; font-family: 'Inter', sans-serif; font-size: 16px;">
                <div id="errorMessage" style="color: #ff4757; font-size: 13px; font-weight: 500; text-align: center; margin-bottom: 15px; display: none;"></div>
                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 16px; font-weight: 600; letter-spacing: 1.5px; border-radius: 8px; background: #fff; color: #000;">
                    <span>AUTHENTICATE</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Dashboard View -->
    <div id="dashboardView" style="display: none;">
        <!-- Premium Navigation -->
        <nav class="premium-nav">
            <div class="nav-brand">
                <img src="{{ 'logo.png' | asset_url }}" alt="OFFCOMFRT" style="height:32px;">
                <h1>OFFCOMFRT</h1>
                <span class="brand-subtitle">SHOPPER HUB</span>
            </div>
            <div class="nav-actions">
                <button id="inboxBtn" class="btn btn-outline" style="border-color: #25d366; color: #25d366;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    Inbox
                    <span id="inboxNavBadge" style="background: #25d366; color: #000; font-size: 0.65rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 10px; margin-left: 0.3rem; display: none;">0</span>
                </button>
                <button id="followUpBtn" class="btn btn-outline" style="border-color: #ffa502; color: #ffa502;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    Follow-Up
                </button>
                <button id="multiOrdersBtn" class="btn btn-outline" style="border-color: #ff4757; color: #ff4757;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Multi Orders
                </button>
                <button id="shippedOrdersBtn" class="btn btn-outline" style="border-color: #53bdeb; color: #53bdeb;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                        <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                    Shipped
                </button>
                <button id="analyticsBtn" class="btn btn-outline">Analytics</button>
                <button id="teamBtn" class="btn btn-outline" style="display: none; border-color: #b18cff; color: #b18cff;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Team
                </button>
                <span id="hubUserBadge" style="display: none; font-size: 0.7rem; font-weight: 600; letter-spacing: 1px; padding: 6px 12px; border-radius: 20px; background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.12); text-transform: uppercase;"></span>
                <button id="exportBtn" class="btn btn-primary">
                    <img src="{{ 'export-icon.svg' | asset_url }}" width="18" height="18" alt="Export Icon" style="vertical-align: middle; margin-right: 6px;" />
                    Export
                </button>
                <button id="hubLogoutBtn" class="btn btn-outline" style="border-color: #ff4757; color: #ff4757;" title="Log out of Shoppers Hub">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Logout
                </button>
            </div>
        </nav>
        
        <!-- Main Content Area -->
        <main class="dashboard-main">
            <header class="page-header">
                <div class="header-content">
                    <h2>Shopper Confirmations</h2>
                    <p>Monitor, track, and manage all automated WhatsApp confirmations in real-time.</p>
                </div>

            </header>
            
            <!-- Bulk Actions Bar (Hidden by default) -->
            <div class="bulk-actions-bar" id="bulkActionsBar">
                <div class="bulk-actions-left">
                    <span class="selected-count"><span id="selectedCount">0</span> selected</span>
                    <button class="bulk-btn bulk-btn-select-all" id="selectAllBtn" onclick="selectAllVisible()">Select All Visible</button>
                    <button class="bulk-btn bulk-btn-select-all" id="selectAllMatchingBtn" onclick="selectAllMatching()">Select All Matching Filters</button>
                </div>
                <div class="bulk-actions-right">
                    <button class="bulk-btn bulk-btn-status" onclick="bulkUpdateStatus('confirmed')">Mark Confirmed</button>
                    <button class="bulk-btn bulk-btn-status" onclick="bulkUpdateStatus('pending')">Mark Pending</button>
                    <button class="bulk-btn bulk-btn-status" onclick="bulkUpdateStatus('cancelled')">Mark Cancelled</button>
                    <button class="bulk-btn bulk-btn-shopify-cancel" onclick="openShopifyCancelModal()">✨ Cancel in Shopify &amp; Refund</button>
                    <button class="bulk-btn bulk-btn-status" style="border-color: rgba(37,211,102,0.5); color: #25d366;" onclick="openBulkShipModal()">Ship Selected</button>
                    <button class="bulk-btn bulk-btn-delete" onclick="bulkDelete()">Delete Selected</button>
                    <button class="bulk-btn-close" onclick="clearSelection()">&times;</button>
                </div>
            </div>
            
            <!-- Segment & Filter Bar -->
            <div class="control-bar">
                <!-- Row 1: Status Tabs -->
                <div class="control-row">
                    <div class="filter-group">
                        <div class="filter-section-title">Status</div>
                        <div class="segment-tabs">
                            <button class="tab active" data-filter="all">All <span class="tab-count" id="countAll"></span></button>
                            <button class="tab" data-filter="pending">Pending <span class="tab-count" id="countPending"></span></button>
                            <button class="tab" data-filter="confirmed">Confirmed <span class="tab-count" id="countConfirmed"></span></button>
                            <button class="tab" data-filter="shipped">Shipped <span class="tab-count" id="countShipped"></span></button>
                            <button class="tab" data-filter="cancelled">Cancelled <span class="tab-count" id="countCancelled"></span></button>
                            <button class="tab" data-filter="edit_details">Edits <span class="tab-count" id="countEdits"></span></button>
                        </div>
                    </div>
                    <button class="clear-filters-btn" id="clearFiltersBtn" style="display: none;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        Clear Filters
                    </button>
                    <div class="view-toggle-wrapper">
                        <button class="view-toggle-btn active" id="viewRowsBtn" title="List view">☰ List</button>
                        <button class="view-toggle-btn" id="viewCardsBtn" title="Card view">▦ Cards</button>
                    </div>
                </div>
                
                <!-- Row 2: Search + Date Filters -->
                <div class="filters-row">
                    <div class="filter-group">
                        <div class="filter-section-title">Search</div>
                        <div class="search-box">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" id="searchInput" placeholder="Search by ID, Name, Phone, Email...">
                        </div>
                    </div>
                    
                    <div class="filter-group">
                        <div class="filter-section-title">Date Range</div>
                        <div class="date-filter-container">
                            <div class="date-filter"><input type="date" id="startDate"></div>
                            <span class="date-separator">to</span>
                            <div class="date-filter"><input type="date" id="endDate"></div>
                        </div>
                    </div>
                    
                    <div class="filter-group">
                        <div class="filter-section-title">Quick Select</div>
                        <div class="quick-date-filters">
                            <button class="quick-date-btn" data-range="today">Today</button>
                            <button class="quick-date-btn" data-range="yesterday">Yesterday</button>
                            <button class="quick-date-btn" data-range="last7">Last 7 Days</button>
                            <button class="quick-date-btn" data-range="last30">Last 30 Days</button>
                            <button class="quick-date-btn" data-range="thisMonth">This Month</button>
                        </div>
                    </div>
                </div>
                
                <!-- Row 3: Advanced Filters -->
                <div class="control-row">
                    <div class="filter-group">
                        <div class="filter-section-title">Advanced Filters</div>
                        <div class="advanced-filters">
                            <div class="order-id-filter">
                                <input type="text" id="orderIdFrom" class="order-id-input" placeholder="From Order #">
                                <span class="order-id-separator">to</span>
                                <input type="text" id="orderIdTo" class="order-id-input" placeholder="To Order #">
                                <button class="btn-apply-small" id="applyOrderIdFilter">Apply</button>
                            </div>
                            
                            <div class="filter-dropdown">
                                <select id="paymentMethodFilter">
                                    <option value="">All Payment Methods</option>
                                    <option value="COD">Cash on Delivery</option>
                                    <option value="Prepaid">Prepaid</option>
                                </select>
                            </div>
                            
                            <div class="filter-dropdown">
                                <select id="deliveryTypeFilter">
                                    <option value="">All Delivery Types</option>
                                    <option value="Standard">Standard</option>
                                    <option value="Express">Express</option>
                                    <option value="Same Day">Same Day</option>
                                </select>
                            </div>
                            
                            <div class="filter-dropdown">
                                <select id="sortByFilter">
                                    <option value="newest">Newest First</option>
                                    <option value="oldest">Oldest First</option>
                                    <option value="amount_high">Amount: High to Low</option>
                                    <option value="amount_low">Amount: Low to High</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Shoppers Grid -->
            <div id="shoppersGrid" class="shoppers-grid">
                <div class="table-loading"><div class="spinner"></div><span>Fetching data...</span></div>
            </div>
            
            <!-- Pagination -->
            <div class="pagination">
                <div class="page-info" id="pageInfo">Showing 0-0 of 0</div>
                <div class="page-controls">
                    <button class="btn btn-primary" id="showMoreBtn" style="display: none;">SHOW MORE</button>
                </div>
            </div>
        </main>
    </div>

    <!-- Edit Modal -->
    <div id="editModal">
        <div class="modal-content">
            <h3>Edit Shopper Details</h3>
            <div id="editCustomerMessage" class="customer-message-box" style="display: none;">
                <div class="msg-header">
                    <span>Customer Message</span>
                    <span id="editMsgTime" style="color: #888; font-size: 0.7rem;"></span>
                </div>
                <div class="msg-content" id="editMsgContent"></div>
            </div>
            <form id="editForm">
                <input type="hidden" id="editShopperId">
                <input type="hidden" id="editOrderId">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" id="editName" required>
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <input type="text" id="editPhone" required>
                </div>
                <div class="form-group">
                    <div class="addr-label-row">
                        <label>Shipping Address</label>
                        <button type="button" class="addr-sync-btn" onclick="pullShopifyAddress()" title="Load the current shipping address from the Shopify order">⟳ Pull from Shopify</button>
                    </div>
                    <textarea id="editAddress" placeholder="Flat / house no., building, street, area"></textarea>
                    <div class="addr-grid">
                        <div>
                            <label>City</label>
                            <input type="text" id="editCity" placeholder="City">
                        </div>
                        <div>
                            <label>State</label>
                            <input type="text" id="editState" placeholder="State">
                        </div>
                        <div>
                            <label>Pincode</label>
                            <input type="text" id="editZip" placeholder="Pincode" inputmode="numeric" maxlength="10">
                        </div>
                    </div>
                    <div id="editAddrSyncStatus" class="addr-sync-status"></div>
                </div>
                <div id="productEditor">
                    <div id="editOrderEditor"></div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" id="cancelEdit">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Details</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Live Chat Modal -->
    <div id="chatModal">
        <div class="chat-container">
            <div class="chat-sidebar">
                <h3>Customer Info</h3>
                <div class="chat-customer-info" id="chatCustomerInfo">
                    <div class="info-row">
                        <span class="info-label">Name:</span>
                        <span class="info-value" id="chatCustomerName">-</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Phone:</span>
                        <span class="info-value" id="chatCustomerPhone">-</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Order:</span>
                        <span class="info-value" id="chatCustomerOrder">-</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Status:</span>
                        <span class="info-value" id="chatCustomerStatus">-</span>
                    </div>
                </div>
                <button class="btn btn-outline" id="viewOrderBtn" style="width: 100%; margin-bottom: 0.5rem;">View Order Details</button>
                <button class="btn btn-primary" id="markResolvedBtn" style="width: 100%;">Mark as Resolved</button>
            </div>
            <div class="chat-main">
                <div class="chat-header">
                    <h4 id="chatHeaderTitle">Live Chat</h4>
                    <button class="chat-close" id="closeChat">&times;</button>
                </div>
                <div class="chat-messages" id="chatMessages">
                    <div class="chat-loading">Loading conversation...</div>
                </div>
                <div class="chat-input-area">
                    <textarea id="chatInput" placeholder="Type your message..."></textarea>
                    <button class="btn btn-chat" id="sendChatBtn">Send</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Full Screen Analytics View -->
    <div id="analyticsView" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 2500; overflow-y: auto;">
        <!-- Analytics Header -->
        <div class="analytics-header">
            <div class="analytics-header-left">
                <button id="backToShoppers" class="btn btn-outline">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                    Back to Shoppers
                </button>
                <h2 style="margin: 0; font-family: 'Outfit', sans-serif; font-size: 1.5rem;">Analytics Dashboard</h2>
            </div>
            <div class="analytics-header-right">
                <div class="analytics-filter-section">
                    <!-- Quick Preset Buttons -->
                    <div class="analytics-quick-filters">
                        <button class="quick-filter-btn" data-range="today">Today</button>
                        <button class="quick-filter-btn" data-range="yesterday">Yesterday</button>
                        <button class="quick-filter-btn active" data-range="last7">Last 7 Days</button>
                        <button class="quick-filter-btn" data-range="last30">Last 30 Days</button>
                        <button class="quick-filter-btn" data-range="thisMonth">This Month</button>
                    </div>
                    <!-- Custom Date Range -->
                    <div class="analytics-date-filter">
                        <span class="filter-label">Custom:</span>
                        <input type="date" id="analyticsStartDate">
                        <span style="color: #666;">to</span>
                        <input type="date" id="analyticsEndDate">
                        <button id="applyAnalyticsDate" class="btn btn-primary">Apply</button>
                    </div>
                </div>
                <button id="exportAnalyticsBtn" class="btn btn-success">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Export to Excel
                </button>
            </div>
        </div>

        <!-- Analytics Content -->
        <div class="analytics-content">
            <!-- Summary Stats Row -->
            <div class="analytics-stats-row">
                <div class="analytics-stat-card total">
                    <div class="stat-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number" id="analyticsTotalOrders">0</span>
                        <span class="stat-label">Total Orders</span>
                    </div>
                </div>
                <div class="analytics-stat-card confirmed">
                    <div class="stat-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number" id="analyticsConfirmed">0</span>
                        <span class="stat-label">Confirmed</span>
                        <span class="stat-percent" id="analyticsConfirmedPct">0%</span>
                    </div>
                </div>
                <div class="analytics-stat-card shipped">
                    <div class="stat-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number" id="analyticsShipped">0</span>
                        <span class="stat-label">Shipped</span>
                        <span class="stat-percent" id="analyticsShippedPct">0%</span>
                    </div>
                </div>
                <div class="analytics-stat-card pending">
                    <div class="stat-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number" id="analyticsPending">0</span>
                        <span class="stat-label">Pending</span>
                        <span class="stat-percent" id="analyticsPendingPct">0%</span>
                    </div>
                </div>
                <div class="analytics-stat-card cancelled">
                    <div class="stat-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-number" id="analyticsCancelled">0</span>
                        <span class="stat-label">Cancelled</span>
                        <span class="stat-percent" id="analyticsCancelledPct">0%</span>
                    </div>
                </div>
                <div class="analytics-stat-card edits">
                    <div class="stat-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                    </div>
                    <div class="stat-info">
